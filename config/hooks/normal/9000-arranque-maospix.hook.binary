#!/bin/sh
# Menú de arranque del live con identidad maospix (isolinux = BIOS, GRUB = UEFI).
# Se ejecuta dentro de binary/, después de que live-build generó los menús.
set -e
M=../config/bootloaders/maospix

# ---------- isolinux (BIOS) ----------
if [ -d isolinux ]; then
  cp "$M/splash-640.png" isolinux/splash.png
  cat > isolinux/stdmenu.cfg <<'EOS'
menu background splash.png
menu color screen	* #00000000 #00000000 none
menu color title	* #ff4fd8e8 #00000000 none
menu color border	* #00000000 #00000000 none
menu color unsel	* #ffc3cde0 #00000000 none
menu color sel		* #ff0f1524 #ff4fd8e8 none
menu color hotkey	* #ffb393f5 #00000000 none
menu color hotsel	* #ff0f1524 #ff4fd8e8 none
menu color tabmsg	* #ff8a97b0 #00000000 none
menu color timeout_msg	* #ff8a97b0 #00000000 none
menu color timeout	* #ff4fd8e8 #00000000 none
menu color help		* #ffc3cde0 #00000000 none
menu color cmdline	* #ffffffff #00000000 none
menu vshift 13
menu rows 8
menu margin 14
menu helpmsgrow 23
menu cmdlinerow 24
menu timeoutrow 25
menu tabmsgrow 27
menu autoboot Arrancando en # segundo{,s}...
menu tabmsg ENTER: iniciar  -  TAB: editar opciones
EOS
  sed -i -e 's/^menu title .*/menu title/' -e 's/^menu width .*/menu width 60/' \
         -e 's/\^Utilities/^Utilidades/; s/menu title Utilities/menu title Utilidades/; s/\^Back\.\./^Volver/' isolinux/menu.cfg
  sed -i -e 's/menu label \^Live system (amd64)/menu label ^Iniciar maospix-xfce/' \
         -e 's/menu label Live system (amd64 fail-safe mode)/menu label Iniciar en modo seguro (graficos basicos)/' isolinux/live.cfg
  sed -i -e 's/^timeout .*/timeout 100/' isolinux/isolinux.cfg
  sed -i -e 's/Hardware Detection Tool (HDT)/Deteccion de hardware (HDT)/' isolinux/utilities.cfg 2>/dev/null || true
fi

# ---------- GRUB (UEFI) ----------
if [ -f boot/grub/grub.cfg ]; then
  cp "$M/splash-800.png" boot/grub/splash.png
  sed -i -e 's/menuentry "Live system (amd64)"/menuentry "Iniciar maospix-xfce"/' \
         -e 's/menuentry "Live system (amd64 fail-safe mode)"/menuentry "Iniciar en modo seguro (gráficos básicos)"/' \
         -e "s/submenu 'Utilities\.\.\.'/submenu 'Utilidades...'/" \
         -e 's/"UEFI Firmware Settings"/"Configuración del firmware (UEFI)"/' \
         -e 's/"Verify integrity of the boot medium"/"Verificar integridad del medio"/' boot/grub/grub.cfg
  # timeout de 10 s y sin pitido
  sed -i -e '/^insmod play/d; /^play /d' boot/grub/config.cfg
  grep -q '^set timeout=' boot/grub/config.cfg || sed -i 's/^set default=0/set default=0\nset timeout=10\nset timeout_style=menu/' boot/grub/config.cfg
  cat > boot/grub/live-theme/theme.txt <<'EOS'
desktop-image: "../splash.png"
desktop-color: "#0f1524"
title-text: ""
message-font: "Unifont Regular 16"
terminal-font: "Unifont Regular 16"

+ boot_menu {
        left = 22%
        width = 56%
        top = 52%
        height = 34%
        item_font = "Unifont Regular 16"
        item_color = "#c3cde0"
        selected_item_font = "Unifont Regular 16"
        selected_item_color = "#4fd8e8"
        item_height = 24
        item_padding = 8
        item_spacing = 6
        icon_width = 0
        icon_height = 0
        item_icon_space = 0
}

+ progress_bar {
        id = "__timeout__"
        left = 30%
        top = 100%-60
        width = 40%
        height = 4
        fg_color = "#4fd8e8"
        bg_color = "#1f2a40"
        border_color = "#1f2a40"
        text = ""
}

+ label {
        top = 100%-40
        left = 0
        width = 100%
        height = 20
        align = "center"
        color = "#8a97b0"
        font = "Unifont Regular 16"
        text = "ENTER: iniciar   ·   E: editar   ·   C: consola"
}
EOS
fi
