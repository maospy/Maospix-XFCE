{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/maospix/maospix-logo.ansi",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "36" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "SO", "format": "maospix-xfce · Debian {codename} {arch}" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Encendido" },
    { "type": "packages", "key": "Paquetes" },
    { "type": "shell", "key": "Shell" },
    { "type": "de", "key": "Escritorio" },
    { "type": "wm", "key": "Ventanas" },
    { "type": "theme", "key": "Tema" },
    { "type": "icons", "key": "Íconos" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memoria" },
    { "type": "disk", "key": "Disco" },
    "break",
    "colors"
  ]
}
